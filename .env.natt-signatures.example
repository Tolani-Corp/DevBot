# NATT asymmetric artifact verification
# Production key IDs must be immutable Azure Key Vault key-version URLs.
NATT_TRUSTED_MISSION_KEY_IDS=https://example.vault.azure.net/keys/natt-mission-signing/00000000000000000000000000000000
NATT_TRUSTED_CAPABILITY_GRANT_KEY_IDS=https://example.vault.azure.net/keys/natt-capability-grant-signing/00000000000000000000000000000000

# Azure workload identity for Key Vault verification.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token

# Local tests only. verifyManagedPayload rejects local-test signatures in production.
# DEBO_NATT_TEST_PUBLIC_KEY_FILE=/absolute/path/to/test-public-key.pem

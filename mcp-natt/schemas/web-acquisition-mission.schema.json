{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolanicorp.us/schemas/devbot/web-acquisition-mission.v1.json",
  "title": "DevBot Web Acquisition Mission",
  "description": "Policy contract for transparent, authorized, rate-limited web acquisition. CAPTCHA bypass, identity spoofing, access-control circumvention, and continued access after an explicit block are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missionId",
    "tenantId",
    "requestedBy",
    "purpose",
    "startUrls",
    "allowedDomains",
    "deniedDomains",
    "dataClassification",
    "publicationAllowed",
    "humanApprovalRequired",
    "allowAuthenticatedPages",
    "providerPreference",
    "budget",
    "resilience"
  ],
  "properties": {
    "missionId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "purpose": {
      "enum": [
        "research",
        "supplier-validation",
        "regulatory-monitoring",
        "competitive-intelligence",
        "dataset-development",
        "security-testing-authorized"
      ]
    },
    "startUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
    },
    "allowedDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "deniedDomains": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "dataClassification": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "publicationAllowed": { "type": "boolean" },
    "humanApprovalRequired": { "type": "boolean" },
    "allowAuthenticatedPages": { "type": "boolean" },
    "providerPreference": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "native-http",
          "crawlee",
          "firecrawl",
          "browserless",
          "manual-review"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPages",
        "maxDepth",
        "maxRequests",
        "maxRuntimeSeconds",
        "maxProviderCredits",
        "maxEstimatedCostUsd",
        "budgetAction"
      ],
      "properties": {
        "maxPages": { "type": "integer", "minimum": 1 },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 20 },
        "maxRequests": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "maxProviderCredits": { "type": "number", "minimum": 0 },
        "maxEstimatedCostUsd": { "type": "number", "minimum": 0 },
        "budgetAction": {
          "enum": [
            "stop",
            "request-approval",
            "return-partial-result",
            "downgrade-provider"
          ]
        }
      }
    },
    "resilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "respectRobotsTxt",
        "identifyAutomation",
        "userAgent",
        "requestsPerMinute",
        "maxConcurrentRequests",
        "minimumDelayMs",
        "jitterMs",
        "retryableStatusCodes",
        "maxRetries",
        "backoffBaseMs",
        "backoffMultiplier",
        "maxBackoffMs",
        "circuitBreakerFailureThreshold",
        "circuitBreakerCooldownMs",
        "cacheTtlSeconds",
        "stopOnCaptcha",
        "stopOnAuthenticationChallenge",
        "stopOnExplicitBlock"
      ],
      "properties": {
        "respectRobotsTxt": { "const": true },
        "identifyAutomation": { "const": true },
        "userAgent": { "type": "string", "minLength": 10 },
        "contactUrl": { "type": "string", "format": "uri" },
        "requestsPerMinute": { "type": "integer", "minimum": 1, "maximum": 600 },
        "maxConcurrentRequests": { "type": "integer", "minimum": 1, "maximum": 20 },
        "minimumDelayMs": { "type": "integer", "minimum": 0 },
        "jitterMs": { "type": "integer", "minimum": 0 },
        "retryableStatusCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "backoffBaseMs": { "type": "integer", "minimum": 1 },
        "backoffMultiplier": { "type": "number", "minimum": 1 },
        "maxBackoffMs": { "type": "integer", "minimum": 1 },
        "circuitBreakerFailureThreshold": { "type": "integer", "minimum": 1 },
        "circuitBreakerCooldownMs": { "type": "integer", "minimum": 1 },
        "cacheTtlSeconds": { "type": "integer", "minimum": 0 },
        "stopOnCaptcha": { "const": true },
        "stopOnAuthenticationChallenge": { "const": true },
        "stopOnExplicitBlock": { "const": true }
      }
    }
  }
}

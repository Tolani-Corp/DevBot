{
  "load_direnv": "direct",
  "enable_language_server": true,
  "format_on_save": "on",
  "formatter": "prettier",
  "line_ending": "prefer_lf",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.turbo",
    "**/.cache",
    "**/coverage",
    "**/temp",
    "**/output",
    "**/.playwright-mcp",
    "**/research/extracted",
    "**/vendor/open-pencil"
  ],
  "scan_symlinks": "expanded",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "autosave": "on_focus_change",
  "code_lens": "on",
  "use_smartcase_search": true,
  "tabs": {
    "show_diagnostics": "errors"
  },
  "git_panel": {
    "starts_open": false,
    "status_style": "icon",
    "fallback_branch_name": "main",
    "collapse_untracked_diff": true
  },
  "project_panel": {
    "auto_fold_dirs": true,
    "auto_reveal_entries": true
  },
  "edit_predictions": {
    "disabled_globs": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.cert",
      "**/*.crt",
      "**/.dev.vars",
      "**/secrets.yml",
      "**/output/**/*.json"
    ]
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "docker-compose": true,
    "toml": true,
    "yaml": true
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 12288
          },
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true
          },
          "referencesCodeLens": {
            "enabled": true,
            "showOnAllFunctions": true
          }
        },
        "javascript": {
          "tsserver": {
            "maxTsServerMemory": 12288
          },
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true
          },
          "referencesCodeLens": {
            "enabled": true,
            "showOnAllFunctions": true
          }
        }
      }
    }
  },
  "terminal": {
    "working_directory": "first_project_directory",
    "detect_venv": "off",
    "toolbar": {
      "breadcrumbs": true
    }
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2,
      "document_symbols": "on"
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2,
      "document_symbols": "on"
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2
    },
    "Markdown": {
      "format_on_save": "off",
      "soft_wrap": "editor_width"
    }
  },
  "context_servers": {
    "natt-knowledge": {
      "command": "npm",
      "args": [
        "--prefix",
        "mcp-natt",
        "run",
        "dev"
      ],
      "env": {
        "PORT": "3111"
      }
    }
  }
}

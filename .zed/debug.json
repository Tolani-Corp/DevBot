[
  {
    "label": "DevBot: debug API and webhooks",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": [
      "run",
      "dev"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "autoAttachChildProcesses": true,
    "skipFiles": [
      "<node_internals>/**"
    ]
  },
  {
    "label": "DevBot: debug worker",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": [
      "run",
      "worker"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "autoAttachChildProcesses": true,
    "skipFiles": [
      "<node_internals>/**"
    ]
  },
  {
    "label": "Web: debug Next.js app",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": [
      "--prefix",
      "web",
      "run",
      "dev"
    ],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "console": "integratedTerminal",
    "autoAttachChildProcesses": true,
    "skipFiles": [
      "<node_internals>/**"
    ]
  }
]

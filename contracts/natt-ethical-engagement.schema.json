{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tolani.example/contracts/natt-ethical-engagement.schema.json",
  "title": "NATT Ethical Hacker Package and Engagement Contract",
  "type": "object",
  "required": ["$id", "version", "status", "owner", "purpose", "governance", "skillContracts", "packages"],
  "properties": {
    "$id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft-commercial", "pilot", "approved", "retired"] },
    "owner": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "governance": { "$ref": "#/$defs/governance" },
    "skillContracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillContract" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    },
    "requiredContractArtifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "governance": {
      "type": "object",
      "required": [
        "defaultMode",
        "requiresWrittenAuthorization",
        "requiresRulesOfEngagement",
        "allowsUnrestrictedBypass",
        "productionCredentialCaptureAllowed",
        "destructiveTestingAllowed",
        "realDataExfiltrationAllowed"
      ],
      "properties": {
        "defaultMode": { "const": "fail-closed" },
        "requiresWrittenAuthorization": { "const": true },
        "requiresRulesOfEngagement": { "const": true },
        "requiresNamedOperator": { "type": "boolean" },
        "requiresEmergencyStopContact": { "type": "boolean" },
        "requiresEvidenceClassification": { "type": "boolean" },
        "allowsUnrestrictedBypass": { "const": false },
        "productionCredentialCaptureAllowed": { "const": false },
        "productionPasswordGuessingAllowed": { "const": false },
        "destructiveTestingAllowed": { "const": false },
        "realDataExfiltrationAllowed": { "const": false },
        "references": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "skillContract": {
      "type": "object",
      "required": ["id", "name", "risk", "modes", "skills", "allowedTools", "inputs", "outputs", "hardLimits"],
      "properties": {
        "id": { "type": "string", "pattern": "^natt\\.[a-z0-9-]+\\.v[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["lab", "passive", "authorized-active"] },
          "uniqueItems": true
        },
        "skills": { "$ref": "#/$defs/nonEmptyStringArray" },
        "allowedTools": { "$ref": "#/$defs/nonEmptyStringArray" },
        "inputs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "outputs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "hardLimits": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "id",
        "name",
        "audience",
        "deliveryModel",
        "pricingModel",
        "includedSkillContracts",
        "scope",
        "deliverables",
        "requiredContracts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^natt-[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "deliveryModel": { "type": "string", "minLength": 1 },
        "pricingModel": { "enum": ["per-seat-or-cohort", "fixed-scope-assessment", "fixed-scope-or-time-boxed-assessment", "custom-quote"] },
        "includedSkillContracts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^natt\\.[a-z0-9-]+\\.v[0-9]+$" },
          "uniqueItems": true
        },
        "scope": { "$ref": "#/$defs/nonEmptyStringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "requiredContracts": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}

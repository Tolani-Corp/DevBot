{
  "name": "@tolani/devbot-teams-sso-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Teams SSO bot surface for DevBot task intake and operator status.",
  "type": "module",
  "main": "./lib/src/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node ./lib/src/index.js",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "engines": {
    "node": "20 || 22 || >=24"
  },
  "dependencies": {
    "@microsoft/agents-activity": "^1.4.1",
    "@microsoft/agents-hosting": "^1.4.1",
    "@microsoft/agents-hosting-express": "^1.4.1",
    "@microsoft/agents-hosting-extensions-teams": "^1.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "axios": "^1.16.0",
    "uuid": "^11.1.1"
  }
}
